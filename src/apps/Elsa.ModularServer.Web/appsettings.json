{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Nuplane": "Warning",
      "CShells": "Warning"
    },
    "Console": {
      "FormatterOptions": {
        "ColorBehavior": "Enabled"
      }
    }
  },
  "AllowedHosts": "*",
  "CShells": {
    "Shells": {
      "Default": {
        "Configuration": {
          "WebRouting": {
            "Path": ""
          }
        },
        "Features": {
          "ShellsApi": {},
          "DefaultAuthentication": {},
          "Resilience": {},
          "Identity": {
            "SigningKey": "CHANGE_ME_TO_A_SECURE_RANDOM_KEY"
          },
          "FastEndpoints": {
            "GlobalRoutePrefix": "elsa/api"
          },
          "PostgreSqlWorkflowPersistence": {
            "ConnectionString": "Host=localhost;Port=5432;Database=elsa;Username=elsa;Password=elsa"
          },
          "PostgreSqlIdentityPersistence": {
            "ConnectionString": "Host=localhost;Port=5432;Database=elsa;Username=elsa;Password=elsa"
          },
          "PostgreSqlExternalAuthenticationPersistence": {
            "ConnectionString": "Host=localhost;Port=5432;Database=elsa;Username=elsa;Password=elsa"
          },
          "Http": {
            "HttpActivityOptions": {
              "BaseUrl": "https://localhost:5001"
            }
          },
          "Alterations": {},
          "Secrets": {
            "EncryptionKey": "Q0hBTkdFX01FX1RPX0FfU0VDVVJFX1JBTkRPTV9LRVk="
          },
          "ExternalAuthentication": {
            "AllowConfigurationConnectionOverrides": true,
            "LocalLogin": {
              "IsEnabled": true
            },
            "Redirects": {
              "ExternalCallbackBaseUri": "https://localhost:7294/elsa/api/"
            },
            "ProviderEgress": {
              "RequireHttps": true,
              "AllowPrivateNetworkDestinations": true,
              "AllowedHosts": [
                "localhost"
              ]
            },
            "UnlinkedIdentityPolicy": {
              "DefaultType": "reject",
              "AllowDatabaseConnectionOverride": true
            },
            "Connections": [],
            "AuthenticationClients": []
          },
          "SecretsJavaScript": {},
          "DashboardApi": {},
          "WorkflowRuntimeDashboard": {},
          "CopilotAI": {},
          "AI": {},
          "AIPersistence": {},
          "PostgreSqlAlterationsPersistence": {
            "ConnectionString": "Host=localhost;Port=5432;Database=elsa;Username=elsa;Password=elsa"
          },
          "SampleEndpoint": {}
        }
      }
    }
  },
  "Nuplane": {
    "Setup": {
      "AutomaticReconciliation": true,
      "PollInterval": "00:01:00",
      "Feeds": [
        {
          "Name": "local-packages",
          "DirectoryPath": "packages",
          "IncludePatterns": [
            "*"
          ],
          "Directory": {
            "Watch": true,
            "DebounceWindow": "00:00:01"
          }
        }
      ]
    },
    "Loading": {
      "Enabled": true,
      "SharedAssemblies": [
        {
          "Name": "Nuplane.Abstractions",
          "PublicKeyToken": "31bf3856ad364e35",
          "MajorVersion": 1
        }
      ]
    }
  }
}
