<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>
            Provides common Entity Framework Core types for implementing Flamme module persistence.
        </Description>
        <PackageTags>flamme extension module persistence efcore</PackageTags>
        <RootNamespace>Flamme.Persistence.EFCore</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Open.Linq.AsyncExtensions"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational"/>
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions"/>
        <PackageReference Include="Scrutor"/>
        <PackageReference Include="System.CommandLine"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Flamme.Common\Flamme.Common.csproj" />
      <ProjectReference Include="..\Flamme.Tenants\Flamme.Tenants.csproj" />
    </ItemGroup>

</Project>
