<Project>
  <PropertyGroup>
    <!-- Keep the package artifact contract for both libraries and app packages. -->
    <PackageOutputPath>$(MSBuildThisFileDirectory)packages/</PackageOutputPath>
    <ContinuousIntegrationBuild Condition="'$(ContinuousIntegrationBuild)' == '' And '$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- Lock executable entrypoints (including tests and benchmarks), rather than library graphs
         whose dependency versions are resolved by their consuming applications. -->
    <RestorePackagesWithLockFile Condition="'$(OutputType)' == 'Exe'">true</RestorePackagesWithLockFile>
    <!-- Runtime async is a compiler opt-in for the supported .NET 11 CoreCLR targets. -->
    <UseRuntimeAsync Condition="'$(UseRuntimeAsync)' == '' And '$(TargetFramework)' == 'net11.0'
                              And '$(UseMonoRuntime)' != 'true'
                              And !$(RuntimeIdentifier.StartsWith('browser-'))
                              And !$(RuntimeIdentifier.StartsWith('wasi-'))">true</UseRuntimeAsync>
    <UseRuntimeAsync Condition="'$(UseRuntimeAsync)' == ''">false</UseRuntimeAsync>
  </PropertyGroup>

  <!-- Features is a compiler option. Scope it after each project's target framework is known. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0' And '$(UseRuntimeAsync)' == 'true'">
    <Features>$(Features);runtime-async=on</Features>
  </PropertyGroup>

  <!-- The SDK cache omits Features. Track it so changing the async model recompiles incrementally. -->
  <Target Name="IncludeCompilerFeaturesInCompileCache" BeforeTargets="_GenerateCompileDependencyCache">
    <ItemGroup>
      <CoreCompileCache Include="CompilerFeatures=$(Features)" />
    </ItemGroup>
  </Target>

  <!-- Use project references instead of NuGet packages for local development -->
  <PropertyGroup>
    <UseProjectReferences>true</UseProjectReferences>
  </PropertyGroup>

  <!-- Locked mode otherwise creates a missing file, leaving a new entrypoint unpinned in CI. -->
  <Target Name="ValidateNuGetLockFile" BeforeTargets="CollectPackageReferences"
          Condition="'$(RestoreLockedMode)' == 'true' And '$(RestorePackagesWithLockFile)' == 'true'">
    <PropertyGroup>
      <_NuGetLockFileToValidate Condition="'$(NuGetLockFilePath)' == ''">$(MSBuildProjectDirectory)/packages.lock.json</_NuGetLockFileToValidate>
      <_NuGetLockFileToValidate Condition="'$(NuGetLockFilePath)' != ''">$(NuGetLockFilePath)</_NuGetLockFileToValidate>
    </PropertyGroup>
    <Error Condition="!Exists('$(_NuGetLockFileToValidate)')"
           Code="FLAMME0003"
           Text="$(MSBuildProjectName) requires a NuGet lock file at '$(_NuGetLockFileToValidate)'. Restore this project without --locked-mode and without selecting a single framework, then commit the generated lock file." />
  </Target>

  <!--
    Guards the ConfigureAwait.Fody directive declared in src/Directory.Build.props.

    ConfigureAwait.Fody weaves nothing unless it is given an explicit ContinueOnCapturedContext
    value, and it reports no warning when the value is absent. That is how 76 projects came to
    ship with a FodyWeavers.xml containing a bare <ConfigureAwait /> and no weaving at all. These
    checks make the same mistake a build failure rather than a silent no-op.
  -->
  <Target Name="ValidateConfigureAwaitDirective" BeforeTargets="CoreCompile">

    <ItemGroup>
      <_ConfigureAwaitFodyReference Include="@(PackageReference)" Condition="'%(Identity)' == 'ConfigureAwait.Fody'" />
    </ItemGroup>

    <PropertyGroup>
      <_HasConfigureAwaitDirective Condition="'$(WeaverConfiguration)' != '' And $(WeaverConfiguration.Contains('ContinueOnCapturedContext=&quot;false&quot;'))">true</_HasConfigureAwaitDirective>
    </PropertyGroup>

    <Error Condition="'@(_ConfigureAwaitFodyReference)' != '' And '$(_HasConfigureAwaitDirective)' != 'true'"
           Code="FLAMME0001"
           Text="$(MSBuildProjectName) references ConfigureAwait.Fody, but the effective weaver configuration does not set ContinueOnCapturedContext=&quot;false&quot;, so the weaver rewrites nothing. Declare the directive in the WeaverConfiguration property (see src/Directory.Build.props), or drop the ConfigureAwait.Fody and Fody package references from this project." />

    <Error Condition="'@(_ConfigureAwaitFodyReference)' != '' And Exists('$(MSBuildProjectDirectory)/FodyWeavers.xml')"
           Code="FLAMME0002"
           Text="$(MSBuildProjectName) has a FodyWeavers.xml, which the WeaverConfiguration MSBuild property silently overrides. Delete the file; the ConfigureAwait directive belongs in src/Directory.Build.props only." />

  </Target>
</Project>
