<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>
    <!-- Keep ASP.NET Core and Extensions packages aligned with each target framework. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageVersion Include="Microsoft.AspNetCore.Authorization" Version="10.0.15"/>
        <PackageVersion Include="Microsoft.AspNetCore.Components" Version="10.0.15"/>
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.15"/>
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.15"/>
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.15"/>
        <PackageVersion Include="Microsoft.AspNetCore.DataProtection.Abstractions" Version="10.0.15"/>
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15"/>
        <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.15"/>
        <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.15"/>
        <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.15"/>
        <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.15"/>
        <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.15"/>
        <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.15"/>
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15"/>
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15"/>
        <PackageVersion Include="Microsoft.Extensions.DependencyModel" Version="10.0.15"/>
        <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.15"/>
        <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.15"/>
        <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.15"/>
        <PackageVersion Include="Microsoft.Extensions.Http.Polly" Version="10.0.15"/>
        <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0"/>
        <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.15"/>
        <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.15"/>
        <PackageVersion Include="Microsoft.Extensions.Resilience" Version="10.11.0"/>
        <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.15"/>
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15"/>
        <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.15"/>
        <PackageVersion Include="System.Formats.Asn1" Version="10.0.15"/>
        <PackageVersion Include="System.Text.Json" Version="10.0.15"/>
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
        <PackageVersion Include="Microsoft.AspNetCore.Authorization" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.AspNetCore.Components" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.AspNetCore.DataProtection.Abstractions" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.Extensions.Configuration" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.Extensions.DependencyModel" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.Extensions.Http" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.Extensions.Http.Polly" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.Extensions.Options" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.Extensions.Resilience" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.Extensions.Logging" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="11.0.0"/>
        <PackageVersion Include="System.Formats.Asn1" Version="11.0.0"/>
        <PackageVersion Include="System.Text.Json" Version="11.0.0"/>
    </ItemGroup>
    <!-- Npgsql 10.0.3 requires EF Core below 11; use the latest compatible EF Core on both targets. -->
    <ItemGroup>
        <PackageVersion Include="FastEndpoints" Version="8.3.0"/>
        <PackageVersion Include="FastEndpoints.Security" Version="8.3.0"/>
        <PackageVersion Include="FastEndpoints.Swagger" Version="8.3.0"/>
        <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.15"/>
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15"/>
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15"/>
        <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3"/>
        <PackageVersion Include="Scrutor" Version="7.0.0"/>
    </ItemGroup>
    <ItemGroup>
        <PackageVersion Include="AspNetCore.Authentication.ApiKey" Version="9.0.0"/>
        <PackageVersion Include="BenchmarkDotNet" Version="0.15.8"/>
        <PackageVersion Include="Bogus" Version="35.6.5"/>
        <PackageVersion Include="ConfigureAwait.Fody" Version="3.4.1" PrivateAssets="All"/>
        <PackageVersion Include="Cronos" Version="0.11.1"/>
        <PackageVersion Include="DistributedLock" Version="2.8.4"/>
        <PackageVersion Include="DistributedLock.Core" Version="1.0.9"/>
        <PackageVersion Include="DistributedLock.FileSystem" Version="1.0.3"/>
        <PackageVersion Include="FluentStorage" Version="6.0.4"/>
        <PackageVersion Include="FluentStorage.Azure.Blobs" Version="6.0.4"/>
        <PackageVersion Include="FluentMigrator" Version="8.0.1"/>
        <PackageVersion Include="Fluid.Core" Version="2.41.1"/>
        <PackageVersion Include="Fody" Version="6.9.3" PrivateAssets="All"/>
        <PackageVersion Include="GitHub.Copilot.SDK" Version="1.0.34"/>
        <PackageVersion Include="Humanizer.Core" Version="3.0.10"/>
        <PackageVersion Include="IronCompress" Version="1.7.0"/>
        <PackageVersion Include="JetBrains.Annotations" Version="2026.2.0"/>
        <PackageVersion Include="Jint" Version="4.18.0"/>
        <PackageVersion Include="JsonSchema.Net" Version="9.7.0"/>
        <PackageVersion Include="LinqKit.Core" Version="1.3.2"/>
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.12.0"/>
        <PackageVersion Include="Microsoft.Identity.Client" Version="4.92.0"/>
        <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0"/>
        <PackageVersion Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0"/>
        <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.3"/>
        <PackageVersion Include="Newtonsoft.Json" Version="13.0.4"/>
        <PackageVersion Include="Npgsql" Version="10.0.3"/>
        <PackageVersion Include="Open.Linq.AsyncExtensions" Version="1.2.0"/>
        <PackageVersion Include="OpenTelemetry" Version="1.21.0"/>
        <PackageVersion Include="OpenTelemetry.AutoInstrumentation" Version="1.19.1"/>
        <PackageVersion Include="OpenTelemetry.Exporter.Console" Version="1.21.0"/>
        <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0"/>
        <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0"/>
        <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0"/>
        <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0"/>
        <PackageVersion Include="OpenTelemetry.Instrumentation.StackExchangeRedis" Version="1.21.0-beta.1"/>
        <PackageVersion Include="Parlot" Version="1.6.0"/>
        <PackageVersion Include="Polly" Version="8.9.1"/>
        <PackageVersion Include="Polly.Extensions" Version="8.9.1"/>
        <PackageVersion Include="Polly.Extensions.Http" Version="3.0.0"/>
        <PackageVersion Include="PolySharp" Version="1.17.1" PrivateAssets="All"/>
        <PackageVersion Include="pythonnet" Version="3.2.1"/>
        <PackageVersion Include="Refit" Version="9.0.2"/>
        <PackageVersion Include="Refit.HttpClientFactory" Version="9.0.2"/>
        <PackageVersion Include="ShortGuid" Version="2.0.1"/>
        <PackageVersion Include="Snappier" Version="1.3.1"/>
        <PackageVersion Include="System.CommandLine" Version="2.0.15"/>
        <PackageVersion Include="System.Linq.Async" Version="7.0.1"/>
        <PackageVersion Include="System.Linq.Dynamic.Core" Version="1.7.4"/>
        <PackageVersion Include="System.Net.Http" Version="4.3.4"/>
        <PackageVersion Include="System.Text.RegularExpressions" Version="4.3.1"/>
        <PackageVersion Include="SSH.NET" Version="2026.0.0"/>
        <PackageVersion Include="Testcontainers" Version="4.16.0"/>
        <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0"/>
        <PackageVersion Include="Testcontainers.RabbitMq" Version="4.16.0"/>
        <PackageVersion Include="Testcontainers.Redis" Version="4.16.0"/>
        <PackageVersion Include="ThrottleDebounce" Version="2.0.2"/>
        <PackageVersion Include="TUnit" Version="1.84.0"/>
        <PackageVersion Include="TUnit.Logging.Microsoft" Version="1.84.0"/>
        <PackageVersion Include="TUnit.Mocks" Version="1.84.0"/>
        <PackageVersion Include="TUnit.AspNetCore" Version="1.84.0"/>
        <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0"/>
    </ItemGroup>
</Project>
