<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <FixtureIncludeGenerator Condition="'$(FixtureIncludeGenerator)' == ''">true</FixtureIncludeGenerator>
    <FixtureIncludeAnalyzer Condition="'$(FixtureIncludeAnalyzer)' == ''">true</FixtureIncludeAnalyzer>
    <FixtureIncludeBuild Condition="'$(FixtureIncludeBuild)' == ''">true</FixtureIncludeBuild>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <UseRuntimeAsync Condition="'$(UseRuntimeAsync)' == '' And '$(TargetFramework)' == 'net11.0'">true</UseRuntimeAsync>
    <UseRuntimeAsync Condition="'$(UseRuntimeAsync)' == ''">false</UseRuntimeAsync>
    <Features Condition="'$(UseRuntimeAsync)' == 'true' And '$(TargetFramework)' == 'net11.0'">$(Features);runtime-async=on</Features>
    <WeaverConfiguration><Weavers><ConfigureAwait ContinueOnCapturedContext="false" /></Weavers></WeaverConfiguration>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Elsa.CodeGeneration.Build" PrivateAssets="All" Condition="'$(FixtureIncludeBuild)' == 'true'" />
    <PackageReference Include="Elsa.CodeGeneration" PrivateAssets="All" Condition="'$(FixtureIncludeGenerator)' == 'true'" />
    <PackageReference Include="Elsa.CodeGeneration.Analyzers" PrivateAssets="All" Condition="'$(FixtureIncludeAnalyzer)' == 'true'" />
    <PackageReference Include="Elsa.CodeGeneration.Abstractions" />
    <PackageReference Include="Elsa.Features" />
    <PackageReference Include="Elsa.NativeAot.Modules.Producer" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="ConfigureAwait.Fody" PrivateAssets="All" />
    <PackageReference Include="Fody" PrivateAssets="All" />
    <Compile Remove="SourceLibrary/**/*.cs" />
  </ItemGroup>
  <Target Name="IncludeFixtureCompilerFeatures" BeforeTargets="_GenerateCompileDependencyCache">
    <ItemGroup><CoreCompileCache Include="FixtureCompilerFeatures=$(Features)" /></ItemGroup>
  </Target>
</Project>
