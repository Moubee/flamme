<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Elsa.Features" />
  </ItemGroup>
  <Target Name="RecordFixtureLibrarySettings" AfterTargets="ResolveElsaCodeGenerationSettings">
    <WriteLinesToFile File="$(MSBuildProjectDirectory)/observed-mode.txt"
                      Lines="framework=$(TargetFramework);host=$(ElsaIsHost);mode=$(ElsaEffectiveExecutionMode);constants=$(DefineConstants)" Overwrite="true" />
  </Target>
</Project>
