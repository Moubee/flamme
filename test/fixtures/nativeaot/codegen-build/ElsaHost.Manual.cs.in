using Elsa.Features.Implementations;
using Elsa.Features.Models;
using Elsa.Features.Services;
using Elsa.NativeAot.Modules.Producer;
using Microsoft.Extensions.DependencyInjection;

namespace Elsa.CodeGeneration;

internal static partial class ElsaHost
{
    internal static IModule CreateModule(IServiceCollection services, CompositionPolicy policy)
#if FIXTURE_PARENTHESIZED_RETURN && ELSA_GENERATED
        => ((FeatureModuleCatalogBuilder.CreateModule(services, GetModuleExports(), policy)));
#elif FIXTURE_PARENTHESIZED_RETURN
        => ((CreateDynamicModule(services, policy)));
#else
    {
#if FIXTURE_DISCARD_EXPORT
        _ = GetModuleExports();
        return CreateDynamicModule(services, policy);
#elif FIXTURE_UNREACHABLE_EXPORT
        if (false) return FeatureModuleCatalogBuilder.CreateModule(services, GetModuleExports(), policy);
        return CreateDynamicModule(services, policy);
#elif FIXTURE_WRONG_HOOK
        return CreateDynamicModule(services, policy);
#elif ELSA_GENERATED
        return FeatureModuleCatalogBuilder.CreateModule(services, GetModuleExports(), policy);
#else
        return CreateDynamicModule(services, policy);
#endif
    }
#endif

    private static IModule CreateDynamicModule(IServiceCollection services, CompositionPolicy policy)
    {
        FixtureSelection.Provider = "Dynamic";
        return new Module(services, policy);
    }

    private static FeatureModuleExport[] GetModuleExports()
    {
        FixtureSelection.Provider = "Generated";
#if FIXTURE_EMPTY_EXPORTS
        return [];
#else
        return [ProducerExports.Foundation];
#endif
    }
}

internal static class FixtureSelection
{
    internal static string Provider { get; set; } = "Unselected";
}
