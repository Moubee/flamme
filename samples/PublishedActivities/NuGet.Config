<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="fork" value="%FLAMME_FEED%" />
    <add key="dependencies" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="fork">
      <package pattern="Flamme" />
      <package pattern="Flamme.*" />
    </packageSource>
    <packageSource key="dependencies"><package pattern="*" /></packageSource>
  </packageSourceMapping>
</configuration>
